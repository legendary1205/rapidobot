# The Rapido-Go panel the bot creates accounts on, and a sudo admin there.
PANEL_URL=https://panel.example.com
PANEL_USERNAME=admin
PANEL_PASSWORD=change-me

# debug | info | warn | error
LOG_LEVEL=info
