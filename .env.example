# Written for you by `rapidobot install`. Only needed if you run it by hand.

# From @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your numeric Telegram id (from @userinfobot). Several: comma-separated.
